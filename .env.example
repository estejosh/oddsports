# --- Telegram ---
TELEGRAM_BOT_TOKEN=            # from @BotFather
TELEGRAM_WEBHOOK_URL=          # public HTTPS endpoint for webhook mode
TELEGRAM_FREE_CHANNEL_ID=      # public broadcast channel
TELEGRAM_STARTER_CHANNEL_ID=
TELEGRAM_ANALYST_CHANNEL_ID=
TELEGRAM_SHARP_CHANNEL_ID=
TELEGRAM_ADMIN_IDS=            # comma-separated user ids; unset = everyone is admin (pre-launch)

# --- Beehiiv (tier source of truth) ---
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# --- AI inference (prose + optional sourced-factor extraction; all math is deterministic code) ---
# Any OpenAI-compatible chat-completions endpoint. No defaults: unset = template prose.
AI_API_BASE=
AI_API_KEY=                             # optional for local servers
AI_MODEL_CHEAP=                        # Free/Starter prose
AI_MODEL_STRONG=                       # Analyst/Sharp prose + factor extraction (falls back to cheap)
# Older names HONE_API_BASE/BTCPC_API_BASE, HONE_API_KEY/BTCPC_API_KEY, MODEL_CHEAP, MODEL_STRONG still work.

# --- Sourced factors (optional, off by default) ---
AI_FACTORS_ENABLED=false
FACTOR_CONTEXT_DIR=             # dir of <game_id>.json source documents you supply

# --- Token budget (USD/day hard ceiling; pipeline degrades gracefully at 100%) ---
DAILY_TOKEN_BUDGET_USD=10
BUDGET_ALERT_THRESHOLD=0.8
MAX_PICKS_PER_DAY=10           # prose latency/cost driver: calls = picks x tier depths

# --- Odds/stats data ---
ODDS_API_KEY=
ODDS_API_BASE=https://api.the-odds-api.com/v4

# --- Output ---
DATA_ATTRIBUTION=Market data via The Odds API (https://the-odds-api.com)   # credit required by the feed's terms
VENDORS_FILE=                   # optional: JSON list of sportsbook vendors (see docs/vendors.example.json)
TEMPLATE_DIR=                  # optional: dir with pick.md / bot_start.txt overrides (private deployments)

# --- Storage ---
DATABASE_PATH=./data/oddsports.sqlite
